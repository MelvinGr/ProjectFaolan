@page "/characters"
@using Faolan.Core.Database
@using Faolan.Web.Services
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
@inject IDbContextFactory<DatabaseContext> DbFactory
@inject CharacterModelService Models
@inject IJSRuntime JS

<PageTitle>Faolan — Character Viewer</PageTitle>

@* ?char=<id> deep-links a character so the viewer auto-loads it (used by headless screenshot tooling). *@

<div class="viewer-page">
    <aside class="roster">
        <h2>Characters</h2>
        @if (_characters == null)
        {
            <p>Loading…</p>
        }
        else if (_characters.Count == 0)
        {
            <p>No characters in the database.</p>
        }
        else
        {
            <ul>
                @foreach (var c in _characters)
                {
                    <li>
                        <button class="@(c.Id == _selected?.Id
                                           ? "sel"
                                           : "")" @onclick="() => Select(c)">
                            <strong>@c.Name</strong>
                            <span>@c.Race @c.Sex · @c.Class</span>
                        </button>
                    </li>
                }
            </ul>
        }
        @if (!Models.RdbAvailable)
        {
            <p class="warn">Client RDB not found — set <code>Rdb:Path</code>.</p>
        }
    </aside>

    <section class="stage">
        <aside class="stats-panel">
            @if (_selected == null)
            {
                <p class="stats-empty">Select a character to view their sheet.</p>
            }
            else
            {
                <div class="stat-head">
                    <div class="stat-name">@_selected.Name</div>
                    <div class="stat-sub">Level @_selected.Level · @_selected.Class</div>
                    <div class="stat-sub2">@_selected.Race · @_selected.Sex</div>
                </div>

                <div class="vitals">
                    @if (_health > 0)
                    {
                        <div class="vital hp"><span class="vlabel">Health</span>
                            <div class="vbar"><i style="width:100%"></i></div>
                            <span class="vval">@_health</span></div>
                    }
                    @if (_mana > 0)
                    {
                        <div class="vital mp"><span class="vlabel">Mana</span>
                            <div class="vbar"><i style="width:100%"></i></div>
                            <span class="vval">@_mana</span></div>
                    }
                    @if (_stamina > 0)
                    {
                        <div class="vital sp"><span class="vlabel">Stamina</span>
                            <div class="vbar"><i style="width:100%"></i></div>
                            <span class="vval">@_stamina</span></div>
                    }
                </div>

                <div class="stat-rows">
                    <div class="srow"><span class="k">Experience</span><span
                            class="v">@_selected.Experience.ToString("N0")</span></div>
                    <div class="srow"><span class="k">Money</span><span class="v">@_money</span></div>
                    <div class="srow"><span class="k">Location</span><span class="v">@_mapName</span></div>
                    <div class="srow"><span class="k">Guild</span><span class="v">@(_guildName ?? "—")</span></div>
                </div>

                @if (_spells.Count > 0)
                {
                    <div class="spellbook">
                        <div class="sb-title">Spells <span class="sb-count">@_spells.Count</span></div>
                        <ul>
                            @foreach (var sp in _spells)
                            {
                                <li>
                                    <span class="sp-name">@sp.Name</span>
                                    <span class="sp-meta">
                                        @if (sp.Level > 0)
                                        {
                                            <span>L@sp.Level</span>
                                        }
                                        @if (sp.Damage > 0)
                                        {
                                            <span>@sp.Damage.ToString("0")% dmg</span>
                                        }
                                        @if (sp.Range > 0)
                                        {
                                            <span>@sp.Range.ToString("0")m</span>
                                        }
                                    </span>
                                </li>
                            }
                        </ul>
                    </div>
                }
            }
        </aside>

        <div class="equip-window">
            <div class="equip-title">Equipment</div>
            <div class="equip-grid">
                @Slot("Head", "center-slot top")
                <div class="equip-col left">
                    @foreach (var s in LeftSlots)
                    {
                        @Slot(s)
                    }
                </div>
                <div class="equip-center">
                    <canvas id="char-canvas"></canvas>
                </div>
                <div class="equip-col right">
                    @foreach (var s in RightSlots)
                    {
                        @Slot(s)
                    }
                </div>
                @Slot("Legs", "center-slot bottom")
            </div>
            <div class="equip-bottom">
                @foreach (var s in WeaponSlots)
                {
                    @Slot(s, "wide")
                }
            </div>
            <div class="equip-tip">
                @if (_selected != null)
                {
                    <div class="tip-line">@_selected.Name — @_selected.Race @_selected.Sex (@_status)</div>
                    <div class="tip-controls" id="pose-controls"></div>
                }
                else
                {
                    <div class="tip-line">Select a character to view their equipment.</div>
                }
            </div>
        </div>

        @{
            var tabItems = TabItems;
        }
        <div class="inv-window">
            <div class="inv-tabs">
                @foreach (var tab in InvTabs)
                {
                    var n = _inventory.Count(i => i.Tab == tab);
                    <button class="inv-tab @(tab == _invTab
                                               ? "sel"
                                               : "")" @onclick="() => SelectInvTab(tab)">
                        @tab
                        @if (n > 0)
                        {
                            <span class="tabcount">@n</span>
                        }
                    </button>
                }
            </div>
            <div class="inv-grid">
                @for (var i = 0; i < InvPageSize; i++)
                {
                    var idx = _invPage * InvPageSize + i;
                    var item = _selected != null && idx < tabItems.Count
                        ? tabItems[idx].Info
                        : (ItemInfo?)null;
                    @ItemSlot(item, "")
                }
            </div>
            <div class="inv-foot">
                @if (tabItems.Count > InvPageSize)
                {
                    <button class="inv-page" disabled="@(_invPage == 0)" @onclick="() => PageInventory(-1)">‹</button>
                    <span>Page @(_invPage + 1) of @InvPageCount</span>
                    <button class="inv-page" disabled="@(_invPage >= InvPageCount - 1)"
                            @onclick="() => PageInventory(1)">›
                    </button>
                }
                else
                {
                    <span>@tabItems.Count item@(tabItems.Count == 1
                                                      ? ""
                                                      : "s")</span>
                }
            </div>
        </div>
    </section>
</div>

@code {

    // Render one item slot (equipment or bag): a 3D thumbnail filled in by JS, the item name as fallback/label (or the
    // placeholder label when empty), a stack-count badge, and data-* attributes the JS tooltip reads on hover.
    private RenderFragment ItemSlot(ItemInfo? info, string label, string extra = "") =>
        @<div
            class="slot @extra @(info != null
                                   ? "filled"
                                   : "")"
            data-item="@(info?.Id.ToString() ?? "")"
            data-name="@(info?.Name)"
            data-type="@(info?.Type)"
            data-level="@(info?.Level ?? 0)"
            data-value="@(info?.Value ?? 0)"
            data-sell="@(info?.Sell ?? 0)"
            data-count="@(info?.Count ?? 0)">
            <img class="slot-img" alt=""/>
            <span class="@(info != null
                             ? "item"
                             : "")">@(info?.Name ?? label)</span>
            @if (info is { Count: > 1 } c)
            {
                <span class="count">@c.Count</span>
            }
        </div>;

}
