@page "/register"

<PageTitle>Register — Project Faolan</PageTitle>

<div class="auth-card">
	<h1>Create account</h1>
	<form method="post" action="/auth/register">
		<input name="username" placeholder="Username" autocomplete="username" required autofocus/>
		<input name="password" type="password" placeholder="Password" autocomplete="new-password" required/>
		<button class="btn primary" type="submit">Register</button>
	</form>
	@if (Error == "taken")
	{
		<p class="err">That username is already taken.</p>
	}
	else if (Error != null)
	{
		<p class="err">Please enter a username and password.</p>
	}
	<p class="alt">Already have an account? <a href="/login">Log in</a></p>
</div>

@code {

	[SupplyParameterFromQuery(Name = "error")]
	public string? Error { get; set; }

}
