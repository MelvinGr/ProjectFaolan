@page "/mail"
@rendermode InteractiveServer
@using System.Security.Claims
@using Faolan.Core.Database
@using Faolan.Web.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<DatabaseContext> DbFactory
@inject MailService Mails
@inject NavigationManager Nav

<PageTitle>Mail — Project Faolan</PageTitle>

<div class="mail-page">
    <h1>Mail</h1>

    @if (!_ready)
    {
        <p class="muted">Loading…</p>
    }
    else if (_characters.Count == 0)
    {
        <p class="muted">This account has no characters with a mailbox.</p>
    }
    else
    {
        <div class="mailbox-tabs">
            @foreach (var c in _characters)
            {
                <button class="mtab @(c == _active ? "sel" : "")" @onclick="() => SelectMailbox(c)">@c</button>
            }
        </div>

        @if (_notice is not null)
        {
            <p class="notice">@_notice</p>
        }

        <div class="mail-cols">
            <section class="panel inbox">
                <h2>Inbox — @_active</h2>
                @if (_mailbox.Count == 0)
                {
                    <p class="muted">No mail.</p>
                }
                else
                {
                    <ul class="mlist">
                        @foreach (var m in _mailbox)
                        {
                            <li class="mitem @(m.IsRead ? "" : "unread") @(_openId == m.MailId ? "open" : "")">
                                <button class="mhead" @onclick="() => Open(m)">
                                    <span class="mfrom">@m.Sender</span>
                                    <span class="mwhen">@m.Sent.ToString("yyyy-MM-dd")</span>
                                    @if (m.Money > 0 || m.Items.Count > 0)
                                    {
                                        <span class="matt">📎</span>
                                    }
                                </button>
                                @if (_openId == m.MailId)
                                {
                                    <div class="mbody">
                                        @if (m.Money > 0)
                                        {
                                            <div class="mline">Money: @Money(m.Money)</div>
                                        }
                                        @foreach (var it in m.Items)
                                        {
                                            <div class="mline">Attached: @it.Qty× @it.Name</div>
                                        }
                                        <div class="mtext">@(string.IsNullOrWhiteSpace(m.Body) ? "(no text)" : m.Body)</div>
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="panel compose">
                <h2>Compose</h2>
                <p class="from">From <strong>@_active</strong></p>
                <input class="ti" placeholder="Recipient character name" @bind="_to" />
                <textarea class="ti body" rows="4" placeholder="Message…" @bind="_body"></textarea>
                @if (_isAdmin)
                {
                    <div class="attach">
                        <span class="alabel">GM attach</span>
                        <input class="ti small" placeholder="money (tin)" @bind="_money" />
                        <input class="ti small" placeholder="item id" @bind="_itemId" />
                        <input class="ti small" placeholder="qty" @bind="_qty" />
                    </div>
                }
                <button class="btn primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_to))" @onclick="Send">Send</button>
            </section>
        </div>
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _ready;
    private bool _isAdmin;
    private List<string> _characters = [];
    private string _active = "";
    private List<MailView> _mailbox = [];
    private ulong? _openId;
    private string? _notice;
    private bool _busy;

    private string _to = "", _body = "";
    private string _money = "", _itemId = "", _qty = "1";

    protected override async Task OnInitializedAsync()
    {
        var user = AuthState is null ? null : (await AuthState).User;
        if (user is null || user.Identity?.IsAuthenticated != true
            || !uint.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var accountId))
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }
        _isAdmin = user.IsInRole("Admin");

        await using var db = await DbFactory.CreateDbContextAsync();
        _characters = await db.Characters
            .Where(c => c.AccountId == accountId && c.Name != null && c.Name != "")
            .OrderBy(c => c.Name).Select(c => c.Name).ToListAsync();

        if (_characters.Count > 0)
        {
            _active = _characters[0];
            _mailbox = await Mails.GetMailboxAsync(_active);
        }
        _ready = true;
    }

    private async Task SelectMailbox(string c)
    {
        _active = c;
        _openId = null;
        _mailbox = await Mails.GetMailboxAsync(c);
    }

    private async Task Open(MailView m)
    {
        if (_openId == m.MailId) { _openId = null; return; }
        _openId = m.MailId;
        if (!m.IsRead)
        {
            await Mails.MarkReadAsync(m.MailId);
            _mailbox = await Mails.GetMailboxAsync(_active); // refresh read flag
        }
    }

    private async Task Send()
    {
        _busy = true;
        ulong money = 0; uint itemId = 0, qty = 1;
        if (_isAdmin)
        {
            ulong.TryParse(_money, out money);
            uint.TryParse(_itemId, out itemId);
            if (!uint.TryParse(_qty, out qty) || qty == 0) qty = 1;
        }
        var (ok, msg) = await Mails.SendAsync(_to.Trim(), _active, _body, money, itemId, qty);
        _notice = msg;
        if (ok)
        {
            _to = _body = ""; _money = _itemId = ""; _qty = "1";
            // If you mailed yourself, refresh the inbox.
            _mailbox = await Mails.GetMailboxAsync(_active);
        }
        _busy = false;
    }

    private static string Money(ulong tin)
    {
        var (g, s, c, t) = (tin / 1_000_000, tin / 10_000 % 100, tin / 100 % 100, tin % 100);
        var parts = new List<string>();
        if (g > 0) parts.Add($"{g}g");
        if (s > 0) parts.Add($"{s}s");
        if (c > 0) parts.Add($"{c}c");
        if (t > 0 || parts.Count == 0) parts.Add($"{t}t");
        return string.Join(" ", parts);
    }
}

<style>
    .mail-page { max-width: 820px; margin: 0 auto; padding: 1rem; }
    .mail-page > h1 { font-size: 1.7rem; margin-bottom: 1rem; }
    .mail-page .muted { color: var(--muted); }
    .notice { background: linear-gradient(180deg, #1f2a1f, #15171b); border: 1px solid #3c5a3c; color: #cfe6c6;
        border-radius: 7px; padding: .55rem .8rem; font-size: .85rem; margin-bottom: 1rem; }

    .mailbox-tabs { display: flex; gap: .35rem; flex-wrap: wrap; margin-bottom: 1rem; }
    .mtab { background: linear-gradient(#1d1f25, #15171b); color: var(--muted); cursor: pointer;
        border: 1px solid var(--stone-dark); border-radius: 6px; padding: .35rem .7rem; font-size: .82rem; }
    .mtab:hover { color: var(--gold); }
    .mtab.sel { color: var(--gold-bright); background: linear-gradient(#322d1d, #241f12); border-color: var(--gold-dim); }

    .mail-cols { display: grid; grid-template-columns: 1.3fr 1fr; gap: 1rem; align-items: start; }
    .panel { background: linear-gradient(180deg, var(--bg-2), #121419); border: 1px solid var(--stone-dark);
        border-radius: var(--radius); padding: .9rem 1rem; }
    .panel h2 { font-size: 1rem; margin-bottom: .75rem; }

    .mlist { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .35rem; }
    .mitem { border: 1px solid var(--line); border-radius: 6px; overflow: hidden; background: var(--field-2); }
    .mitem.unread .mfrom { color: var(--gold-bright); font-weight: 600; }
    .mitem.open { border-color: var(--gold-dim); }
    .mhead { width: 100%; display: flex; align-items: center; gap: .5rem; background: linear-gradient(var(--field), var(--field-2));
        color: var(--text); border: none; cursor: pointer; padding: .5rem .65rem; text-align: left; }
    .mfrom { flex: 1; font-size: .85rem; }
    .mwhen { color: var(--muted); font-size: .72rem; }
    .matt { color: var(--gold); }
    .mbody { padding: .6rem .7rem; border-top: 1px solid var(--stone-dark); font-size: .82rem; }
    .mline { color: var(--gold); font-size: .76rem; margin-bottom: .25rem; }
    .mtext { color: var(--text); white-space: pre-wrap; word-break: break-word; margin-top: .3rem; }

    .compose .from { color: var(--muted); font-size: .8rem; margin-bottom: .5rem; }
    .compose .from strong { color: var(--gold); }
    .ti { width: 100%; box-sizing: border-box; padding: .5rem .65rem; border-radius: 6px; border: 1px solid var(--line);
        background: var(--field); color: var(--text); font-size: .88rem; margin-bottom: .5rem; }
    .ti:focus { outline: none; border-color: var(--gold-dim); }
    .ti.body { resize: vertical; font-family: inherit; }
    .attach { display: flex; gap: .4rem; align-items: center; flex-wrap: wrap; margin-bottom: .5rem; }
    .attach .alabel { font-size: .7rem; text-transform: uppercase; color: var(--muted); letter-spacing: .04em; }
    .attach .small { width: 6rem; margin-bottom: 0; }

    @@media (max-width: 720px) { .mail-cols { grid-template-columns: 1fr; } }
</style>
