@page "/"

<PageTitle>Project Faolan</PageTitle>

<div class="landing">
    <h1>Project Faolan</h1>
    <p class="tag">An Age of Conan server emulator — explore characters, their gear, and 3D models.</p>
    <div class="cta">
        <AuthorizeView>
            <Authorized>
                <a class="btn primary" href="/characters">Open the viewer</a>
                <form method="post" action="/auth/logout"><button class="btn ghost" type="submit">Log out (@context.User.Identity?.Name)</button></form>
            </Authorized>
            <NotAuthorized>
                <a class="btn primary" href="/login">Log in</a>
                <a class="btn" href="/register">Register</a>
                <a class="btn ghost" href="/characters">Browse characters</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

<style>
    .landing { max-width: 40rem; margin: 12vh auto; text-align: center; padding: 0 1rem; }
    .landing h1 { font-size: 2.6rem; color: #d8c07a; letter-spacing: .04em; margin: 0 0 .5rem; }
    .landing .tag { color: #b7b2a2; font-size: 1.05rem; margin-bottom: 2rem; }
    .cta { display: flex; gap: .75rem; justify-content: center; flex-wrap: wrap; align-items: center; }
    .cta form { margin: 0; }
    .btn { display: inline-block; padding: .6rem 1.4rem; border-radius: 7px; text-decoration: none;
        border: 1px solid #5a4d33; color: #e6d8a8; background: #25272e; font-size: .95rem; cursor: pointer; }
    .btn.primary { background: linear-gradient(#5a4d33, #463c28); border-color: #b89544; color: #fbeec2; }
    .btn.ghost { background: transparent; color: #9a937f; }
    .btn:hover { border-color: #b89544; }
</style>
