@page "/"

<PageTitle>Project Faolan</PageTitle>

<div class="landing">
    <div class="crest">⚔</div>
    <h1>Project Faolan</h1>
    <p class="tag">An Age of Conan server emulator — explore characters, their gear, and 3D models.</p>
    <div class="cta">
        <AuthorizeView>
            <Authorized>
                <a class="btn primary" href="/characters">Open the viewer</a>
                <a class="btn" href="/account">My account</a>
                <form method="post" action="/auth/logout"><button class="btn ghost" type="submit">Log out (@context.User.Identity?.Name)</button></form>
            </Authorized>
            <NotAuthorized>
                <a class="btn primary" href="/login">Log in</a>
                <a class="btn" href="/register">Register</a>
                <a class="btn ghost" href="/characters">Browse characters</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

<style>
    .landing { max-width: 42rem; margin: 14vh auto; text-align: center; padding: 0 1rem; }
    .crest { width: 4.5rem; height: 4.5rem; margin: 0 auto 1.25rem; border-radius: 50%;
        display: grid; place-items: center; font-size: 1.9rem; color: var(--gold);
        background: radial-gradient(circle at 50% 35%, #2a2517, #15171b);
        border: 1px solid var(--stone); box-shadow: inset 0 0 18px #000a, 0 6px 22px #0008; }
    .landing h1 { font-size: 3rem; letter-spacing: .06em; margin: 0 0 .6rem;
        text-shadow: 0 2px 18px #0008; }
    .landing .tag { color: var(--muted); font-size: 1.1rem; margin: 0 auto 2.25rem; max-width: 32rem; }
    .cta { display: flex; gap: .75rem; justify-content: center; flex-wrap: wrap; align-items: center; }
    .cta form { margin: 0; }
</style>
