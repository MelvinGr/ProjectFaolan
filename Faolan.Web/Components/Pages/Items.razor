@page "/items"
@rendermode InteractiveServer
@using Faolan.Web.Services
@inject CharacterModelService Models
@inject IJSRuntime JS

<PageTitle>Armory — Project Faolan</PageTitle>

<div class="armory">
    <div class="armory-head">
        <h1>Armory</h1>
        <div class="armory-controls">
            <input class="search" placeholder="Search items…" value="@_query"
                   @oninput="e => _query = e.Value?.ToString() ?? string.Empty"
                   @onkeyup="OnKey" />
            <select class="type" @bind="_type" @bind:after="Search">
                <option value="">All types</option>
                <option value="101">Equipped</option>
                <option value="104">Normal</option>
                <option value="112">Resource</option>
                <option value="113">Quest</option>
            </select>
            <button class="btn primary" @onclick="Search">Search</button>
        </div>
    </div>

    @if (_loading)
    {
        <p class="armory-status">Searching…</p>
    }
    else if (_items.Count == 0)
    {
        <p class="armory-status">No items match.</p>
    }
    else
    {
        <p class="armory-status">@_total item@(_total == 1 ? "" : "s") found · page @(_page + 1) of @PageCount</p>
        <div class="item-grid">
            @foreach (var it in _items)
            {
                <div class="icard slot" data-item="@it.Id" data-name="@it.Name" data-type="@it.Type"
                     data-level="@it.Level" data-value="@it.Value" data-sell="@it.Sell" data-count="0">
                    <div class="icard-thumb">
                        <img class="slot-img" alt="" />
                        <span class="icard-ph">@Initials(it.Name)</span>
                    </div>
                    <div class="icard-name">@it.Name</div>
                    <div class="icard-meta">
                        @if (it.Type != "Normal") { <span>@it.Type</span> }
                        @if (it.Level > 0) { <span>L@it.Level</span> }
                        @if (it.Sell > 0) { <span>@it.Sell t</span> }
                    </div>
                </div>
            }
        </div>
        @if (PageCount > 1)
        {
            <div class="armory-pager">
                <button class="btn ghost" disabled="@(_page == 0)" @onclick="() => Page(-1)">‹ Prev</button>
                <span>@(_page + 1) / @PageCount</span>
                <button class="btn ghost" disabled="@(_page >= PageCount - 1)" @onclick="() => Page(1)">Next ›</button>
            </div>
        }
    }
</div>

@code {
    private const int PageSize = 48;

    private string _query = "";
    private string _type = "";
    private int _page;
    private int _total;
    private bool _loading;
    private IReadOnlyList<ItemInfo> _items = [];
    private IJSObjectReference? _module;
    private bool _refreshThumbs;

    private int PageCount => Math.Max(1, (int)Math.Ceiling(_total / (double)PageSize));

    protected override void OnInitialized() => Load();

    private void Search()
    {
        _page = 0;
        Load();
    }

    private void Page(int delta)
    {
        _page = Math.Clamp(_page + delta, 0, PageCount - 1);
        Load();
    }

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            Search();
    }

    private void Load()
    {
        _loading = true;
        var type = int.TryParse(_type, out var t) ? t : (int?)null;
        (_items, _total) = Models.SearchItems(_query, type, _page, PageSize);
        _loading = false;
        _refreshThumbs = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/viewer.js");
            await _module.InvokeVoidAsync("initItemTooltips");
        }
        if (_refreshThumbs && _module is not null)
        {
            _refreshThumbs = false;
            await _module.InvokeVoidAsync("populateItemThumbs");
        }
    }

    // Placeholder glyph for items without a 3D model: the name's initials.
    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 0 ? "?" : parts.Length == 1
            ? parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant()
            : (parts[0][..1] + parts[1][..1]).ToUpperInvariant();
    }
}

<style>
    .armory { max-width: 1100px; margin: 0 auto; padding: 1rem; }
    .armory-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
    .armory-head h1 { font-size: 1.8rem; }
    .armory-controls { display: flex; gap: .5rem; align-items: center; flex-wrap: wrap; }
    .armory-controls .search, .armory-controls .type {
        padding: .5rem .7rem; border-radius: 6px; border: 1px solid #46484f;
        background: var(--field); color: var(--text); font-size: .9rem; }
    .armory-controls .search { width: 16rem; max-width: 60vw; }
    .armory-controls .search:focus, .armory-controls .type:focus { outline: none; border-color: var(--gold-dim); }
    .armory-status { color: var(--muted); font-size: .85rem; margin: .75rem 0; }

    .item-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: .7rem; }
    .icard { position: relative; display: flex; flex-direction: column; gap: .4rem;
        background: linear-gradient(180deg, var(--panel), #15171b); border: 1px solid var(--line);
        border-radius: 8px; padding: .6rem; cursor: default; transition: border-color .12s, transform .05s; }
    .icard:hover { border-color: var(--gold-dim); }
    .icard-thumb { position: relative; aspect-ratio: 1 / 1; border-radius: 6px;
        background: radial-gradient(120% 90% at 50% 35%, #1c3b38 0%, #0e1d22 70%, #0a1014 100%);
        border: 1px solid #2c4a48; display: grid; place-items: center; overflow: hidden; }
    .icard-thumb .slot-img { display: none; position: absolute; inset: 4px; width: calc(100% - 8px);
        height: calc(100% - 8px); object-fit: contain; }
    .icard.has-img .slot-img { display: block; }
    .icard.has-img .icard-ph { display: none; }
    .icard-ph { font-family: var(--font-display); color: #5e7c79; font-size: 1.4rem; letter-spacing: .05em; }
    .icard-name { color: var(--gold-bright); font-size: .82rem; line-height: 1.2;
        overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
    .icard-meta { display: flex; flex-wrap: wrap; gap: .35rem; color: var(--muted); font-size: .68rem; margin-top: auto; }

    .armory-pager { display: flex; align-items: center; justify-content: center; gap: 1rem; margin: 1.25rem 0;
        color: var(--muted); font-size: .85rem; }
    .armory-pager .btn { padding: .45rem 1rem; }
</style>
