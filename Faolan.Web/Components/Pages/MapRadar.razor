@page "/admin/map"
@rendermode InteractiveServer
@using System.Security.Claims
@using Faolan.Core.Database
@using Faolan.Web.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<DatabaseContext> DbFactory
@inject LiveSessionService Live
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IAsyncDisposable

<PageTitle>Live Map — Admin</PageTitle>

<div class="radar-page">
    <div class="radar-head">
        <h1>Live Map</h1>
        @if (_authorized)
        {
            <select class="map-select" @bind="MapId" @bind:after="OnMapChanged">
                @foreach (var m in _maps)
                {
                    <option value="@m.Id">@m.Id — @m.Name</option>
                }
            </select>
        }
    </div>

    @if (!_authorized)
    {
        <p class="muted">Checking access…</p>
    }
    else
    {
        <div class="radar-wrap">
            <canvas id="radar-canvas"></canvas>
        </div>
        <div class="radar-legend">
            <span><i class="dot p"></i> Player</span>
            <span><i class="dot h"></i> Hostile NPC</span>
            <span><i class="dot n"></i> NPC</span>
            <span><i class="dot l"></i> Loot</span>
            <span id="radar-status" class="radar-status">Loading…</span>
        </div>
        <p class="hint">Auto-refreshes every 3s from the live server. Scale is real world coordinates where the map's bounds are known, otherwise auto-fit to the entities (see the status line).</p>
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _authorized;
    private uint MapId { get; set; } = 4010; // Tortage Island default
    private List<(uint Id, string Name)> _maps = [];
    private IJSObjectReference? _module;

    protected override async Task OnInitializedAsync()
    {
        var user = AuthState is null ? null : (await AuthState).User;
        if (user is null || !user.IsInRole("Admin"))
        {
            Nav.NavigateTo("/", forceLoad: true);
            return;
        }

        _authorized = true;

        await using var db = await DbFactory.CreateDbContextAsync();
        _maps = (await db.Maps.OrderBy(m => m.Id).Select(m => new { m.Id, m.Name }).ToListAsync())
            .Select(m => (m.Id, m.Name)).ToList();

        // Default to a map a player is actually on, if any (so the radar opens on something live).
        var sessions = await Live.GetSessionsAsync();
        var liveCharId = sessions?.FirstOrDefault(s => s.CharacterId is not null)?.CharacterId;
        if (liveCharId is { } cid)
        {
            var c = await db.Characters.FirstOrDefaultAsync(x => x.Id == cid);
            if (c is not null) MapId = c.MapId;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _authorized)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/radar.js");
            await _module.InvokeVoidAsync("start", "radar-canvas", MapId);
        }
    }

    private async Task OnMapChanged()
    {
        if (_module is not null)
            await _module.InvokeVoidAsync("setMap", MapId);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("stop");
                await _module.DisposeAsync();
            }
        }
        catch { /* circuit already gone */ }
    }
}

<style>
    .radar-page { max-width: 820px; margin: 0 auto; padding: 1rem; }
    .radar-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: .9rem; }
    .radar-head h1 { font-size: 1.7rem; margin: 0; }
    .map-select { background: var(--field); color: var(--text); border: 1px solid var(--line);
        border-radius: 6px; padding: .45rem .6rem; font-size: .85rem; max-width: 60vw; }
    .map-select:focus { outline: none; border-color: var(--gold-dim); }
    .muted { color: var(--muted); }

    .radar-wrap { border: 2px solid var(--stone); border-radius: var(--radius); overflow: hidden;
        box-shadow: inset 0 0 24px #000a, var(--shadow); background: #0c0e11; }
    #radar-canvas { display: block; width: 100%; height: auto; aspect-ratio: 1 / 1; }

    .radar-legend { display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; margin-top: .7rem; font-size: .8rem; color: var(--muted); }
    .radar-legend .dot { display: inline-block; width: .65rem; height: .65rem; border-radius: 50%; margin-right: .3rem; vertical-align: middle; }
    .dot.p { background: #5fd06a; } .dot.h { background: #e0553f; } .dot.n { background: #d8b53f; } .dot.l { background: #9a937f; }
    .radar-status { margin-left: auto; color: var(--gold); }
    .radar-status.off { color: var(--danger); }
    .hint { color: var(--muted); font-size: .76rem; margin-top: .6rem; }
</style>
