@page "/admin/account/{Id:int}"
@rendermode InteractiveServer
@using System.Security.Claims
@using Faolan.Core.Enums
@using Faolan.Web.Services
@using AccountInfo = Faolan.Web.Services.AccountDetail
@inject AccountAdminService AdminSvc
@inject LiveSessionService Live
@inject NavigationManager Nav

<PageTitle>Account — Admin</PageTitle>

<div class="adetail">
    <a class="back" href="/admin">‹ All accounts</a>

    @if (!_authorized)
    {
        <p class="muted">Checking access…</p>
    }
    else if (_account is null)
    {
        <p class="muted">Account not found.</p>
    }
    else
    {
        <h1>@_account.UserName @if (_isSelf) { <span class="you">you</span> }</h1>
        @if (_notice is not null)
        {
            <p class="notice">@_notice</p>
        }

        <div class="cards">
            <div class="card meta">
                <div class="row"><span class="k">Account type</span>
                    <span class="v">
                        <select value="@_account.Type" disabled="@_isSelf" @onchange="ChangeType">
                            @foreach (var t in Enum.GetValues<AccountType>())
                            {
                                <option value="@t" selected="@(t == _account.Type)">@t</option>
                            }
                        </select>
                    </span></div>
                <div class="row"><span class="k">State</span>
                    <span class="v"><span class="state @_account.State.ToString().ToLower()">@_account.State</span></span></div>
                <div class="row"><span class="k">Created</span><span class="v">@_account.CreationDate.ToString("yyyy-MM-dd")</span></div>
                <div class="row"><span class="k">Last login</span><span class="v">@(_account.LastConnection?.ToString("yyyy-MM-dd HH:mm") ?? "—")</span></div>
                <div class="row"><span class="k">Last IP</span><span class="v mono">@(_account.LastIp ?? "—")</span></div>
                <div class="row actions">
                    @if (_account.State == AccountState.Banned)
                    {
                        <button class="abtn unban" @onclick="() => SetBan(false)">Unban account</button>
                    }
                    else
                    {
                        <button class="abtn ban" disabled="@_isSelf" @onclick="() => SetBan(true)">Ban account</button>
                    }
                </div>
            </div>

            <div class="card">
                <h2>Characters (@_account.Characters.Count)</h2>
                @if (_account.Characters.Count == 0)
                {
                    <p class="muted">No characters.</p>
                }
                else
                {
                    <ul class="chars">
                        @foreach (var c in _account.Characters)
                        {
                            <a class="char" href="@($"/characters?char={c.Id}")">
                                <span class="cname">@c.Name</span>
                                <span class="csub">Lvl @c.Level · @c.Race @c.Class · @Money(c.Money)</span>
                            </a>
                        }
                    </ul>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _authorized;
    private bool _isSelf;
    private uint _selfId;
    private AccountInfo? _account;
    private string? _notice;

    protected override async Task OnInitializedAsync()
    {
        var user = AuthState is null ? null : (await AuthState).User;
        if (user is null || !user.IsInRole("Admin"))
        {
            Nav.NavigateTo("/", forceLoad: true);
            return;
        }
        uint.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out _selfId);
        _authorized = true;
        await Reload();
    }

    private async Task Reload()
    {
        _account = await AdminSvc.GetAccountAsync((uint)Id);
        _isSelf = _account is not null && _account.Id == _selfId;
    }

    private async Task SetBan(bool banned)
    {
        if (banned && _isSelf) return;
        var state = await AdminSvc.SetBannedAsync((uint)Id, banned);
        if (state is null)
        {
            _notice = "Account not found.";
        }
        else
        {
            var kicked = banned ? await Live.KickAccountAsync((uint)Id) : 0;
            _notice = $"Account is now {state}." + (kicked > 0 ? $" Kicked {kicked} live session(s)." : "");
        }
        await Reload();
    }

    private async Task ChangeType(ChangeEventArgs e)
    {
        if (_isSelf) return;
        if (!Enum.TryParse<AccountType>(e.Value?.ToString(), out var type)) return;
        var set = await AdminSvc.SetTypeAsync((uint)Id, type);
        _notice = set is null ? "Account not found." : $"Account set to {set}.";
        await Reload();
    }

    // tin -> g/s/c/t.
    private static string Money(ulong tin)
    {
        var (g, s, c, t) = (tin / 1_000_000, tin / 10_000 % 100, tin / 100 % 100, tin % 100);
        var parts = new List<string>();
        if (g > 0) parts.Add($"{g}g");
        if (s > 0) parts.Add($"{s}s");
        if (c > 0) parts.Add($"{c}c");
        if (t > 0 || parts.Count == 0) parts.Add($"{t}t");
        return string.Join(" ", parts);
    }
}

<style>
    .adetail { max-width: 820px; margin: 0 auto; padding: 1rem; }
    .adetail .back { display: inline-block; color: var(--muted); font-size: .85rem; margin-bottom: .75rem; }
    .adetail .back:hover { color: var(--gold); }
    .adetail > h1 { font-size: 1.7rem; margin-bottom: 1rem; }
    .adetail .muted { color: var(--muted); }
    .you { font-size: .62rem; color: var(--muted); border: 1px solid var(--line); border-radius: 8px; padding: 0 .4em; vertical-align: middle; }
    .notice { background: linear-gradient(180deg, #1f2a1f, #15171b); border: 1px solid #3c5a3c; color: #cfe6c6;
        border-radius: 7px; padding: .55rem .8rem; font-size: .85rem; margin-bottom: 1rem; }

    .cards { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; align-items: start; }
    .card { background: linear-gradient(180deg, var(--panel), #15171b); border: 1px solid var(--stone);
        border-radius: var(--radius); padding: 1rem 1.1rem; box-shadow: var(--shadow); }
    .card h2 { font-size: 1rem; margin-bottom: .75rem; }
    .meta .row { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: .45rem 0;
        border-bottom: 1px solid var(--stone-dark); }
    .meta .row:last-child { border-bottom: none; }
    .meta .k { color: var(--muted); font-size: .85rem; }
    .meta .v { color: var(--text); font-size: .85rem; }
    .meta .v.mono { font-family: ui-monospace, monospace; }
    .meta select { background: var(--field); color: var(--text); border: 1px solid var(--line); border-radius: 5px; padding: .25rem .4rem; }
    .meta select:disabled { opacity: .5; }
    .actions { padding-top: .75rem; }

    .state { font-size: .72rem; text-transform: uppercase; letter-spacing: .04em; padding: .1rem .45em; border-radius: 8px; }
    .state.active { color: #8fd08a; background: #1f2a1f; }
    .state.banned { color: #e89a8a; background: #2a1c1c; }
    .state.unactivated { color: var(--muted); background: #222; }

    .abtn { border-radius: 5px; padding: .4rem .9rem; font-size: .82rem; cursor: pointer; border: 1px solid var(--line);
        background: linear-gradient(var(--field), var(--field-2)); color: var(--text); }
    .abtn.ban:hover:not(:disabled) { border-color: #a44; color: #f0b3a6; }
    .abtn.unban { border-color: #3c5a3c; color: #cfe6c6; }
    .abtn:disabled { opacity: .4; cursor: default; }

    .chars { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .45rem; }
    .char { display: flex; flex-direction: column; text-decoration: none;
        background: linear-gradient(var(--field), var(--field-2)); border: 1px solid var(--line);
        border-radius: 6px; padding: .5rem .65rem; transition: border-color .12s; }
    .char:hover { border-color: var(--gold-dim); }
    .cname { color: var(--gold-bright); font-size: .85rem; }
    .csub { color: var(--muted); font-size: .76rem; }

    @@media (max-width: 720px) { .cards { grid-template-columns: 1fr; } }
</style>
