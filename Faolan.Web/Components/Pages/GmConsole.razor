@page "/gm"
@rendermode InteractiveServer
@using Faolan.Web.Services
@inject LiveSessionService Live
@inject NavigationManager Nav

<PageTitle>GM Console — Project Faolan</PageTitle>

<div class="gm">
    <div class="gm-head">
        <h1>GM Console</h1>
        <button class="btn ghost" @onclick="Refresh" disabled="@_busy">Refresh</button>
    </div>

    @if (!_authorized)
    {
        <p class="muted">Checking access…</p>
    }
    else if (_online is null)
    {
        <p class="offline">Game server is offline — no live actions available.</p>
    }
    else
    {
        @if (_notice is not null)
        {
            <p class="notice">@_notice</p>
        }

        <section class="panel broadcast">
            <h2>Broadcast</h2>
            <div class="bcast-row">
                <input class="ti" placeholder="Message to all connected players…" @bind="_broadcast" @bind:event="oninput" />
                <button class="btn primary" disabled="@(_busy || _online.Count == 0 || string.IsNullOrWhiteSpace(_broadcast))"
                        @onclick="Broadcast">Send to all (@_online.Count)</button>
            </div>
        </section>

        @if (_online.Count == 0)
        {
            <p class="muted">No players are connected right now.</p>
        }
        else
        {
            <div class="players">
                @foreach (var s in _online)
                {
                    var id = s.CharacterId;
                    <section class="panel player">
                        <div class="phead">
                            <span class="pname">@(s.CharacterName ?? "(character select)")</span>
                            <span class="psub">@(s.CharacterLevel is { } lvl ? $"Lvl {lvl}" : "")@(s.AccountName is { } a ? $" · {a}" : "")</span>
                        </div>

                        @if (id is { } cid)
                        {
                            <div class="prow">
                                <input class="ti" placeholder="Whisper a system message…"
                                       value="@Msg(cid)" @oninput="e => _msgs[cid] = e.Value?.ToString() ?? string.Empty" />
                                <button class="btn" disabled="@(_busy || string.IsNullOrWhiteSpace(Msg(cid)))"
                                        @onclick="() => Whisper(cid)">Send</button>
                            </div>
                            <div class="quick">
                                <button class="btn ghost" disabled="@_busy" @onclick='() => Gm(cid, "heal")'>Heal</button>
                                <button class="btn ghost" disabled="@_busy" @onclick='() => Gm(cid, "kill")'>Kill</button>
                                <input class="ti cmd" placeholder="GM command (e.g. level 80)"
                                       value="@Cmd(cid)" @oninput="e => _cmds[cid] = e.Value?.ToString() ?? string.Empty" />
                                <button class="btn" disabled="@(_busy || string.IsNullOrWhiteSpace(Cmd(cid)))"
                                        @onclick="() => Gm(cid, Cmd(cid))">Run</button>
                            </div>
                        }
                        else
                        {
                            <p class="muted">No character bound yet (still in character select).</p>
                        }
                    </section>
                }
            </div>
        }
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _authorized;
    private bool _busy;
    private IReadOnlyList<LiveSession>? _online;
    private string _broadcast = "";
    private string? _notice;
    private readonly Dictionary<uint, string> _msgs = new();
    private readonly Dictionary<uint, string> _cmds = new();

    private string Msg(uint id) => _msgs.TryGetValue(id, out var v) ? v : "";
    private string Cmd(uint id) => _cmds.TryGetValue(id, out var v) ? v : "";

    protected override async Task OnInitializedAsync()
    {
        var user = AuthState is null ? null : (await AuthState).User;
        if (user is null || !user.IsInRole("Admin"))
        {
            Nav.NavigateTo("/", forceLoad: true);
            return;
        }
        _authorized = true;
        await Refresh();
    }

    private async Task Refresh()
    {
        _online = await Live.GetSessionsAsync();
    }

    private async Task Broadcast()
    {
        if (_online is null || string.IsNullOrWhiteSpace(_broadcast)) return;
        _busy = true;
        var sent = 0;
        foreach (var s in _online)
            if (s.CharacterId is { } id && await Live.SendSystemMessageAsync(id, _broadcast) is not null)
                sent++;
        _notice = $"Broadcast sent to {sent} player(s).";
        _broadcast = "";
        _busy = false;
    }

    private async Task Whisper(uint id)
    {
        _busy = true;
        var res = await Live.SendSystemMessageAsync(id, Msg(id));
        _notice = res ?? "Server unreachable.";
        _msgs[id] = "";
        _busy = false;
    }

    private async Task Gm(uint id, string command)
    {
        if (string.IsNullOrWhiteSpace(command)) return;
        _busy = true;
        var res = await Live.RunGmCommandAsync(id, command);
        _notice = res ?? "Server unreachable.";
        if (_cmds.ContainsKey(id)) _cmds[id] = "";
        await Refresh();
        _busy = false;
    }
}

<style>
    .gm { max-width: 880px; margin: 0 auto; padding: 1rem; }
    .gm-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; }
    .gm-head h1 { font-size: 1.7rem; margin: 0; }
    .gm .muted { color: var(--muted); }
    .offline { background: linear-gradient(180deg, #2a1c1c, #15171b); border: 1px solid #5a2d2d; color: #e8c2c2;
        border-radius: 7px; padding: .65rem .9rem; }
    .notice { background: linear-gradient(180deg, #1f2a1f, #15171b); border: 1px solid #3c5a3c; color: #cfe6c6;
        border-radius: 7px; padding: .55rem .8rem; font-size: .85rem; margin-bottom: 1rem; }

    .panel { background: linear-gradient(180deg, var(--bg-2), #121419); border: 1px solid var(--stone-dark);
        border-radius: var(--radius); padding: .9rem 1rem; margin-bottom: 1rem; }
    .panel h2 { font-size: .95rem; margin-bottom: .6rem; }
    .ti { flex: 1; min-width: 0; padding: .5rem .65rem; border-radius: 6px; border: 1px solid var(--line);
        background: var(--field); color: var(--text); font-size: .88rem; }
    .ti:focus { outline: none; border-color: var(--gold-dim); }
    .bcast-row, .prow, .quick { display: flex; gap: .5rem; align-items: center; }
    .quick { margin-top: .5rem; flex-wrap: wrap; }
    .quick .cmd { min-width: 10rem; }
    .panel .btn { padding: .5rem .9rem; white-space: nowrap; }

    .phead { display: flex; align-items: baseline; gap: .5rem; margin-bottom: .6rem; }
    .pname { color: var(--gold-bright); font-weight: 600; }
    .psub { color: var(--muted); font-size: .78rem; }
</style>
