@namespace Faolan.Web.Components.Shared
@inject IJSRuntime JS
@implements IAsyncDisposable

@* Reusable panel/window: a titled card with a collapse toggle and, when Floating, fixed positioning + drag-by-title-bar.
   Docked (Floating=false) windows sit in normal flow. Positioning/sizing for a floating window is passed via Style. The
   body is the child content, rendered as direct children of the card so a scrolling region inside keeps its layout. *@
<div class="win @(Floating
	                ? "floating"
	                : "docked") @Class @(_collapsed
		                                   ? "collapsed"
		                                   : "")" id="@Id" style="@Style">
	<div class="win-bar" id="@BarId">
		<span class="win-title">@Title</span>
		@HeaderExtra
		@if (Floating && Collapsible)
		{
			<button class="win-collapse" type="button" title="@(_collapsed
				                                                  ? "Expand"
				                                                  : "Collapse")"
			        @onclick="() => _collapsed = !_collapsed" @onclick:stopPropagation="true"
			        @onpointerdown:stopPropagation="true">
				@(_collapsed
					? "▢"
					: "—")
			</button>
		}
	</div>
	@ChildContent
</div>

@code {

	[Parameter]
	public string Title { get; set; } = "";

	// DOM id for the card (drag targets <Id>-bar). Required for Floating windows so the drag handle can be found.
	[Parameter]
	public string? Id { get; set; }

	[Parameter]
	public string? Class { get; set; }

	// Inline style for the card - anchor/size a floating window here (e.g. "top:4.75rem; right:1.25rem; width:16.5rem;").
	[Parameter]
	public string? Style { get; set; }

	// Floating: position:fixed + draggable by the title bar. Docked (false): normal document flow.
	[Parameter]
	public bool Floating { get; set; }

	[Parameter]
	public bool Collapsible { get; set; } = true;

	[Parameter]
	public RenderFragment? ChildContent { get; set; }

	// Optional extra controls in the title bar (before the collapse button).
	[Parameter]
	public RenderFragment? HeaderExtra { get; set; }

	[Parameter]
	public bool Collapsed { get; set; }

	private bool _collapsed;

	private IJSObjectReference? _module;

	private string BarId => $"{Id}-bar";

	// Seed the runtime collapse state from the Collapsed parameter once. Keeping the toggle in a private field rather
	// than the parameter means a parent re-render cannot reset it: a [Parameter] set internally is overwritten on the
	// next render.
	protected override void OnInitialized()
	{
		_collapsed = Collapsed;
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender && Floating && !string.IsNullOrEmpty(Id))
		{
			_module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/viewer.js");
			await _module.InvokeVoidAsync("makeDraggable", Id, BarId);
		}
	}

	public async ValueTask DisposeAsync()
	{
		if (_module != null)
		{
			try
			{
				await _module.DisposeAsync();
			}
			catch (JSDisconnectedException)
			{
			}
		}
	}

}
