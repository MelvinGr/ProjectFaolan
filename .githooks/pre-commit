#!/bin/sh
# Keeps faolan.sql in step with faolan.db (#379). The binary db is the interim store; the .sql seed is the
# reviewable mirror of it - and the thing that eventually REPLACES it, when the schema+seed move to a real
# database and the binary is dropped. Running both in parallel means the migration is a deletion, not a port.
#
# DATA ONLY - no CREATE TABLE, no __EFMigrationsHistory. The SCHEMA has exactly one owner, the EF migrations in
# Faolan.Core.Database.Migrations.{Sqlite,Postgres}; mirroring it here as well made every column change show up
# twice in review and invited the dump to drift into a second, unapplied source of truth. The migrations history
# is per-database bookkeeping, not content - dumping it churned the diff and broke the restore (loading it into a
# database the EF tools had just created fails on that row's primary key).
#
# DIALECT-NEUTRAL (#411): the seed is GENERATED from the EF model by `Faolan.Importer --report sql-seed`
# (SqlSeedWriter), not by `sqlite3 .dump`, so ONE file loads into both SQLite and Postgres:
#   - identifiers quoted, so Postgres does not fold "Items" to "items"
#   - an explicit column list per row, so column ORDER is irrelevant (a positional dump only loads against the
#     order it came from, and a db grown through migrations drifts out of it - EF's SQLite table rebuilds re-emit
#     columns alphabetically)
#   - literals rendered from each property's CLR type, NOT from the value the reader returns: SQLite has no
#     boolean storage class and hands back 0/1, which Postgres rejects for a `boolean` column
#   - tables emitted in foreign-key dependency order, so it loads with constraints ENFORCED instead of needing
#     the least portable statement of all (`PRAGMA foreign_keys=OFF` vs `SET session_replication_role = replica`)
# It is ONE file, with no per-dialect part left: the counter resync after inserting explicit ids used to live in
# faolan.seq.{sqlite,postgres}.sql sidecars, and those are gone - no game-content table has a store-generated key
# any more (every one is keyed by its identity), so both were empty. SqlSeedWriter throws rather than emit a seed
# that would need one.
#
# Restoring: create the schema (`dotnet ef database update`), then run faolan.sql. Verified at 0 errors with full
# row parity into a fresh SQLite AND a fresh Postgres, values compared bit-exact.
#
# Regenerates ONLY when faolan.db is actually being committed, so a normal code commit costs nothing and the
# server's session writes (character positions, timestamps) never churn the seed on their own.
#
# Dumps the STAGED BLOB, not the working file, for two reasons: the working copy may hold newer session writes
# than you are committing, and under WAL it can LAG its -wal sidecar - so dumping the file could silently mirror
# something that is not what lands in the commit. `git show :faolan.db` is exactly what is being committed.
#
# CHARACTERS ARE EXCLUDED - none of their rows are dumped. They are per-developer play state, not reference
# content: position, vitals, quest progress and inventory move every session, and the imported reference
# characters are reproducible at any time (`--only characters,character-state,learned-spells,character-abilities,
# character-quests,character-bank`). Keeping them out is what makes faolan.sql a reviewable diff of game DATA
# rather than a log of whoever last logged in. The excluded set is DERIVED (Characters plus everything that
# reaches it through foreign keys), never a hardcoded list that would go stale the first time a CharacterX table
# is added - SqlSeedWriter walks the model for it.
set -e

git diff --cached --name-only | grep -qx 'faolan.db' || exit 0

if ! command -v dotnet >/dev/null 2>&1; then
	echo "pre-commit: dotnet not found - faolan.sql would go stale against faolan.db. Install the SDK, or" >&2
	echo "            commit with --no-verify if you know the seed is already current." >&2
	exit 1
fi

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
git show :faolan.db > "$tmp"

# Point the exporter at the staged copy rather than the working faolan.db (--Database:ConnectionString overrides the
# configured connection; see CliConfig). It writes faolan.sql into the repo root.
dotnet run --project Faolan.Importer --verbosity quiet -- --report sql-seed --Database:ConnectionString "Data Source=$tmp"

git add faolan.sql
echo "pre-commit: regenerated faolan.sql from the staged faolan.db ($(wc -l < faolan.sql) lines, characters excluded)"
