root = true

[*]
charset = utf-8 
# Remove utf-8-bom: find . -type f \( -iname "*.cs" -o -iname "*.sql" -o -iname "*.razor" -iname "*.cshtml" \) -exec sed -i "1s/^\xEF\xBB\xBF//" "{}" \;
end_of_line = crlf
insert_final_newline = true
indent_style = tab
indent_size = tab
tab_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{cs,cshtml,razor}]
# -------------------------------
# Warnings as errors
# -------------------------------

# CA1510: Use ArgumentNullException throw helper
dotnet_diagnostic.CA1510.severity = error

# CA1822: Mark members as static
dotnet_diagnostic.CA1822.severity = warning

# CA1829: Use Length/Count property instead of Enumerable.Count method
dotnet_diagnostic.CA1829.severity = error

# CA1861: Avoid constant arrays as arguments
#dotnet_diagnostic.CA1861.severity = error

# CA2000: Call System.IDisposable.Dispose on object created by 'x' before all references to it are out of scope
#dotnet_diagnostic.CA2000.severity = warning

# CA2263: Prefer generic overload when type is known
dotnet_diagnostic.CA2263.severity = error

# CS0108: Member hides inherited member; missing 'new' keyword
dotnet_diagnostic.CS0108.severity = error

# CS0114: 'x' hides inherited member 'y'. To make the current member override that implementation, add the override keyword. Otherwise add the new keyword.
dotnet_diagnostic.CS0114.severity = error

# CS0169: Field is never used
dotnet_diagnostic.CS0169.severity = error

# CS1998: Async method lacks 'await' operators and will run synchronously
dotnet_diagnostic.CS1998.severity = error

# CS0219: The variable is assigned but its value is never used
dotnet_diagnostic.CS0219.severity = error

# CS4014: Because this call is not awaited, execution continues before completion
dotnet_diagnostic.CS4014.severity = error

# CS0472: Expression is always false due to null comparison on non-nullable value type
dotnet_diagnostic.CS0472.severity = error

# CS8073: Result of expression is always false (similar nullability comparison issue)
dotnet_diagnostic.CS8073.severity = error

# xUnit1005: Fact methods should not have parameters
dotnet_diagnostic.xUnit1005.severity = error

# xUnit1006: Theory methods must have parameters
dotnet_diagnostic.xUnit1006.severity = error

# xUnit1013: Public method on test class is not a test method
dotnet_diagnostic.xUnit1013.severity = error

# xUnit1026: Theory method uses parameter that is not provided by InlineData
dotnet_diagnostic.xUnit1026.severity = error

# xUnit1051: Calls to methods which accept CancellationToken should use TestContext.Current.CancellationToken
dotnet_diagnostic.xUnit1051.severity = error

# xUnit2002: Do not use Assert.Equal() for boolean checks; use Assert.True/False
dotnet_diagnostic.xUnit2002.severity = error

# xUnit2012: Do not use Assert.False() to check if a value exists in a collection. Use Assert.DoesNotContain instead
dotnet_diagnostic.xUnit2012.severity = error

# xUnit2013: Do not use Assert.Equal() for collections; use Assert.Single, etc.
dotnet_diagnostic.xUnit2013.severity = error

# xUnit2029: Do not use Assert.Empty to check if a value does not exist in a collection; Use Assert.DoesNotContain
dotnet_diagnostic.xUnit2029.severity = error

# xUnit2031: Do not use Where clause with Assert.Single
dotnet_diagnostic.xUnit2031.severity = error

# xUnit2051: Do not use Assert.Equal() to check for null; use Assert.Null
dotnet_diagnostic.xUnit2051.severity = error

# -------------------------------
# Disabled warnings
# -------------------------------

# CA1859: Use concrete types when possible for improved performance
dotnet_diagnostic.CA1859.severity = none

# CA1860: Avoid using 'Enumerable.Any()' extension method
dotnet_diagnostic.CA1860.severity = none

# CS1591: Missing XML comment for publicly visible type or member
dotnet_diagnostic.CS1591.severity = none

# CS8632: Nullable annotations outside a '#nullable' context
dotnet_diagnostic.CS8632.severity = none

# CS8669: Auto-generated code requires explicit '#nullable' directive
dotnet_diagnostic.CS8669.severity = none

# IDE0090: Use 'new(...)' (target-typed new)
dotnet_diagnostic.IDE0090.severity = none

# IDE0290: Use primary constructor
dotnet_diagnostic.IDE0290.severity = none

# IDE0305: Simplify collection initialization
dotnet_diagnostic.IDE0305.severity = none

# RS1038: Analyzer should not reference Microsoft.CodeAnalysis.Workspaces
dotnet_diagnostic.RS1038.severity = none

# RS2008: Enable analyzer release tracking
dotnet_diagnostic.RS2008.severity = none

# BL0007: Component parameter should be auto property (Blazor)
dotnet_diagnostic.BL0007.severity = none

# SQL71558: The object reference differs only by case
dotnet_diagnostic.SQL71558.severity = warning

# -------------------------------
# Using/import directives
# -------------------------------

# Place 'System' namespaces first (e.g., System.*, then others)
dotnet_sort_system_directives_first = true

# Do not separate using groups with blank lines
dotnet_separate_import_directive_groups = false

# Remove unused using statements automatically
dotnet_remove_unnecessary_imports = true

# -------------------------------
# Formatting / Styles
# -------------------------------

# Do not indent contents of case blocks inside switch statements
csharp_indent_case_contents = false

# Require 'var' for built-in types
csharp_style_var_for_built_in_types = true:error

# Require 'var' when the type is obvious
csharp_style_var_when_type_is_apparent = true:error

# Require 'var' in all other cases
csharp_style_var_elsewhere = true:error

# IDE0301
#dotnet_style_prefer_collection_expression = true:error

# IDE0028
dotnet_style_collection_initializer = true:error

# Enforce block-scoped namespaces
csharp_style_namespace_declarations = block_scoped:error

# -------------------------------
# Enforcement of styles
# -------------------------------

# Use 'var' instead of explicit type
dotnet_diagnostic.IDE0007.severity = error

# Use explicit type instead of 'var'
dotnet_diagnostic.IDE0008.severity = none

# dotnet_style_collection_initializer
dotnet_diagnostic.IDE0028.severity = error

# dotnet_style_prefer_collection_expression
dotnet_diagnostic.IDE0301.severity = error

