{
	"Database": {
		"Provider": "Sqlite", // Postgres
		"ConnectionString": "Data Source=faolan.db" // "Host=localhost;Port=5432;Database=faolan;Username=faolan;Password=faolan"
	},

	"ServerIpAddress": "127.0.0.1",
	"UniverseAgentPort": 7010,
	"PlayerAgentPort": 7011,

	"WelcomeString": "Welcome to Project Faolan!",

	"Account": {
		"Premium": true,
		"PremiumCharSlots": 10,
		"FreeCharSlots": 4
	},

	"Login": {
		//"PrivateKey": "",
		//"PublicKey": "",
		//"RetailPublicKey": "",
		"AllowUnpatchedClients": true
	},

	"TerrainDir": "../../ProjectFaolan-Data/Terrain",

	"Mcp": {
		"Enabled": true,
		"Port": 7099,
		"Url": "http://127.0.0.1:7099/mcp" // Faolan.Mcp chat-bridge -> game-server MCP endpoint
	},

	// Faolan.Web.Content CDN mirror (override with --CdnMirror:Store / :Ip / :Port, or CdnMirror__* in the env).
	"CdnMirror": {
		"Store": "mirror-store",
		"Ip": "127.0.0.1",
		"Port": 7081
	},

	// Chat-bridge (defaults shown)
	"ChatBridge": {
		// "PollMs": 1500,
		// "BacklogGraceMs": 120000
	},

	"Log": {
		"File": "faolan.log", // log file location (default faolan.log in the CWD); point at a mounted volume in a container
		"PacketBytes": true // false = drop the raw header/body hex dump, keep just the opcode + lengths
	}
}
