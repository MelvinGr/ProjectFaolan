// Project Faolan configuration - every setting, at its default.
//
// GENERATED by FaolanSettings.WriteDefaultJson(); the catalog it comes from (Faolan.Core/Cli/FaolanSettings.cs) is
// also the bottom layer of the configuration stack, so a key deleted from this file still has its default. The
// layering is: defaults < faolan.json < faolan.user.json < command line < environment.
//
// Machine-specific values do NOT belong here - this file is committed and must stay machine-agnostic. Put them
// in faolan.user.json for example.
{
	"Account": {
		// How many character slots an account gets when it is not premium.
		"FreeCharSlots": 4,
		// Tell every client its account is subscribed, so nothing is gated behind a subscription.
		"Premium": true,
		// How many character slots an account gets when it is premium.
		"PremiumCharSlots": 10
	},

	"Cdn": {
		// The interface the CDN mirror BINDS. Not an address to dial - that is Cdn:PublicAddress.
		"ListenAddress": "0.0.0.0",
		// The port the CDN mirror BINDS, on Cdn:ListenAddress. Not a port to dial - that is Cdn:PublicAddress.
		"ListenPort": 7081,
		// The full URL every mirror CLIENT dials, scheme and port included. http ONLY - the game client's libcurl has no SSL.
		"PublicAddress": "http://127.0.0.1:7081",
		// Where the CDN mirror keeps the blobs it has fetched.
		"Store": "./cdn-store"
	},

	"Content": {
		// The client build the protocol was decoded against. Another build is WARNED about, never refused.
		"ClientVersion": "v5.01.0@602248",
		// Announce a player's kill STREAK - the running count of kills strung together inside nine seconds. Off, no chain is tracked and the client is told nothing.
		"KillStreaks": true,
		// The client's RDB folder, part of the game INSTALL. Read by the importer, the RDB tools and Faolan.Web's model viewer - the server itself never needs it.
		"RdbDir": null,
		// Where the baked terrain lives. Without it the server still runs, with ground-snap and line-of-sight disabled.
		"TerrainDir": "./terrain"
	},

	"Database": {
		// The database to serve from. One with no game content in it is filled from faolan.sql on first run.
		"ConnectionString": "Data Source=faolan.db",
		// The engine that database runs on. [Sqlite, Postgres]
		"Provider": "Sqlite"
	},

	"Log": {
		// Where the server writes its log, alongside the console.
		"File": "faolan.log",
		// Add the raw byte dump to every packet log line. Verbose - for protocol work.
		"PacketBytes": false
	},

	"Mcp": {
		// Host the in-process MCP endpoint: database queries, live-session inspection and GM commands.
		"Enabled": false,
		// The BASE port the MCP endpoint binds. Loopback only, so there is no address to configure.
		// A realm host binds this plus its realm's offset from the first realm, so realm 1 is 7099, realm 2 is 7100
		// and so on - without that, every realm process in a multi-realm run binds the same port and all but the
		// first dies on "address already in use" (#910). Set it per process to override.
		"Port": 7099
	},

	// The realms this deployment serves - the STATIC half of each Realm row, reconciled into the database at
	// startup. The LIVE columns are not here and cannot be declared: Online status and the heartbeat are written
	// by the host that serves the realm, and LoadStatus is its population.
	// Ids are explicit and must stay stable: every character, guild, mail and auction listing is FK'd to one.
	// Declare the whole set - a later layer overrides an entry's keys but cannot remove an entry.
	"Realms": [
		{
			"Id": 1,
			"Name": "Project Faolan",
			"IpAddress": "127.0.0.1",
			"Port": 7014,
			"ChatServerPort": 7012,
			"CsPlayerAgentPort": 7001,
			"Type": "PvP",
			"Country": "English"
		}
	],

	"Server": {
		// The interface the server BINDS. Not an address to dial - that is Server:PublicAddress.
		"ListenAddress": "0.0.0.0",
		// The port the PlayerAgent binds - the tier the UniverseAgent hands a client on to.
		"PlayerAgentPort": 7011,
		// The login DH private key, 64 hex characters - generate one with --generate-login-key. Unset, no password is ever checked; set, every client must be patched (Faolan.ClientLauncher --patch-login) or it is refused.
		"PrivateKey": null,
		// The address the login tier ADVERTISES to clients - no port, and it must be reachable FROM the client. A DNS name is fine.
		"PublicAddress": "127.0.0.1",
		// Patch THIS public key into clients, 256 hex characters, instead of the one derived from Server:PrivateKey - for a client that talks to somebody ELSE's server. Only Faolan.ClientLauncher reads it.
		"PublicKey": null,
		// The port the UniverseAgent binds - where a client enters, and the only port it has to be told about.
		"UniverseAgentPort": 7010,
		// The message a client is greeted with at login. $BUILDSTRING expands to this server's build.
		"WelcomeString": "Welcome to Project Faolan!"
	}
}
