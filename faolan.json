// Project Faolan configuration - every setting, at its default.
//
// GENERATED by FaolanSettings.WriteDefaultJson(); the catalog it comes from (Faolan.Core/Cli/FaolanSettings.cs) is
// also the bottom layer of the configuration stack, so a key deleted from this file still has its default. The
// layering is: defaults < faolan.json < faolan.user.json < command line < environment.
//
// The commented-out keys are the OPTIONAL ones - they name something outside this repo (a game install, a keypair,
// a deployment's public address), so there is nothing it could default them to.
//
// ⚠️ Machine-specific values do NOT belong here - this file is committed and must stay machine-agnostic. Put them
// in faolan.user.json (gitignored, same keys, it simply wins).
{
	"Database": {
		// Sqlite or Postgres.
		"Provider": "Sqlite",
		// The database to serve from; built from faolan.sql on first run if it has no content.
		"ConnectionString": "Data Source=faolan.db"
	},

	// The address the login tier advertises to clients - must be reachable FROM the client.
	"ServerIpAddress": "127.0.0.1",
	// Login-tier entry port (7010 is the client's fixed entry point).
	"UniverseAgentPort": 7010,
	// Login-tier player-agent port.
	"PlayerAgentPort": 7011,
	// Login MOTD.
	"WelcomeString": "Welcome to Project Faolan!",
	// Baked terrain directory; without it ground-snap and line-of-sight are disabled.
	"TerrainDir": "../../ProjectFaolan-Data/Terrain",
	// The client's RDB folder. Part of the game INSTALL, so it has no default.
	//"RdbDir": ""
	// The client build the protocol was decoded against. A client reporting anything else is not refused.
	"ClientVersion": "v5.01.0@602248",

	"Login": {
		// The login DH private key (default: the built-in one, which is public - generate your own with --generate-login-key). Patch clients with the matching public key: Faolan.ClientLauncher --patch-login.
		//"PrivateKey": ""
		// Patch THIS public key into the exe instead of our derived one - for a client that should talk to somebody else's server.
		//"PublicKey": ""
		// Let a client whose login block we cannot decrypt in on its account NAME alone. False requires a patched client, so the password is actually checked.
		"AllowUnpatchedClients": true
	},

	"Account": {
		// Advertise every account as subscribed.
		"Premium": true,
		// Character slots advertised when premium.
		"PremiumCharSlots": 10,
		// Character slots advertised when not premium.
		"FreeCharSlots": 4
	},

	"Log": {
		// Log file path.
		"File": "faolan.log",
		// Include the raw byte dump in packet log lines.
		"PacketBytes": false
	},

	"Mcp": {
		// Host the in-process MCP endpoint.
		"Enabled": false,
		// MCP endpoint port.
		"Port": 7099,
		// MCP endpoint URL the chat bridge connects to.
		"Url": "http://127.0.0.1:7099/mcp"
	},

	"ChatBridge": {
		// How long the chat bridge treats a channel's history as backlog rather than new traffic, in milliseconds.
		"BacklogGraceMs": 120000,
		// Chat-bridge poll interval, in milliseconds.
		"PollMs": 1500
	},

	"CdnMirror": {
		// Directory the mirror stores fetched CDN blobs in.
		"Store": "mirror-store",
		// Address the mirror binds.
		"Ip": "127.0.0.1",
		// Port the mirror binds.
		"Port": 7081
		// Address the CLIENT reaches the mirror on, written into LocalConfig.xml's patch addresses (default: the inbound request's Host header).
		//"PublicAddress": ""
	}
}
