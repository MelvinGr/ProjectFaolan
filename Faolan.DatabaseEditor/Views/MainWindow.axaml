<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Faolan.DatabaseEditor.ViewModels"
        mc:Ignorable="d"
        d:DesignWidth="1200"
        d:DesignHeight="760"
        x:Class="Faolan.DatabaseEditor.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Faolan.DatabaseEditor">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <DockPanel>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                <Button Grid.Column="0"
                        Content="Add row"
                        Command="{Binding AddCommand}"
                        Padding="14,6"
                        Margin="0,0,8,0" />

                <Button Grid.Column="1"
                        Content="Delete row"
                        Command="{Binding DeleteCommand}"
                        Padding="14,6"
                        Margin="0,0,8,0" />

                <Button Grid.Column="2"
                        Content="Save"
                        Command="{Binding SaveCommand}"
                        Padding="18,6" />

                <TextBlock Grid.Column="3"
                           Text="{Binding Status}"
                           VerticalAlignment="Center"
                           Opacity="0.75"
                           Margin="16,0" />
            </Grid>
        </Border>

        <Grid ColumnDefinitions="240,320,*">

            <!-- Tables -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Tables"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12" />

                    <ListBox ItemsSource="{Binding Tables}"
                             SelectedItem="{Binding SelectedTable, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TableViewModel">
                                <TextBlock Text="{Binding Name}"
                                           Margin="0,3" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Rows -->
            <Border Grid.Column="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Rows"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12" />

                    <TextBox DockPanel.Dock="Top"
                             Text="{Binding Filter, Mode=TwoWay}"
                             PlaceholderText="Filter rows..."
                             Margin="0,0,0,12" />

                    <ListBox ItemsSource="{Binding Rows}"
                             SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:RowViewModel">
                                <TextBlock Text="{Binding Display}"
                                           Margin="0,3"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Property editors -->
            <DockPanel Grid.Column="2"
                       Margin="16">
                <TextBlock DockPanel.Dock="Top"
                           Text="Properties"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12" />

                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding SelectedRowEditors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PropertyEditorViewModel">
                                <Grid ColumnDefinitions="220,*"
                                      Margin="0,4">

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               VerticalAlignment="Center" />

                                    <TextBox Grid.Column="1"
                                             Text="{Binding TextValue, Mode=TwoWay}"
                                             IsVisible="{Binding UsesTextBox}" />

                                    <CheckBox Grid.Column="1"
                                              IsChecked="{Binding BooleanValue, Mode=TwoWay}"
                                              IsVisible="{Binding IsBoolean}" />

                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding EnumValues}"
                                              SelectedItem="{Binding Value, Mode=TwoWay}"
                                              IsVisible="{Binding IsEnum}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
