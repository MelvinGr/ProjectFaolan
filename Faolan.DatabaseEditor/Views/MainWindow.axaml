<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Faolan.DatabaseEditor.ViewModels"
        mc:Ignorable="d"
        d:DesignWidth="1100"
        d:DesignHeight="700"
        x:Class="Faolan.DatabaseEditor.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Faolan.DatabaseEditor">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="280,*"
          RowDefinitions="*">

        <!-- Accounts list -->
        <Border Grid.Column="0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,1,0"
                Padding="12">

            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Accounts"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12" />

                <Button DockPanel.Dock="Bottom"
                        Content="Save"
                        Command="{Binding SaveCommand}"
                        HorizontalAlignment="Stretch"
                        Margin="0,12,0,0"
                        Padding="18,8" />

                <ListBox ItemsSource="{Binding Accounts}"
                         SelectedItem="{Binding SelectedAccount, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <TextBlock Text="{Binding UserName}"
                                           FontWeight="SemiBold" />

                                <TextBlock Text="{Binding Id}"
                                           Opacity="0.65"
                                           FontSize="12" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Right side -->
        <Grid Grid.Column="1"
              RowDefinitions="Auto,*,Auto,*"
              Margin="16">

            <TextBlock Grid.Row="0"
                       Text="Account properties"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12" />

            <!-- Account property editors -->
            <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding SelectedAccountEditors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PropertyEditorViewModel">
                            <Grid ColumnDefinitions="220,*"
                                  Margin="0,4">

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Name}"
                                           VerticalAlignment="Center" />

                                <TextBox Grid.Column="1"
                                         Text="{Binding TextValue, Mode=TwoWay}"
                                         IsVisible="{Binding UsesTextBox}" />

                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding BooleanValue, Mode=TwoWay}"
                                          IsVisible="{Binding IsBoolean}" />

                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding EnumValues}"
                                          SelectedItem="{Binding Value, Mode=TwoWay}"
                                          IsVisible="{Binding IsEnum}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="2"
                       Text="Characters"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,20,0,12" />

            <!-- Character list + selected character properties -->
            <Grid Grid.Row="3"
                  ColumnDefinitions="280,*">

                <Border Grid.Column="0"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="0,0,12,0">

                    <ListBox ItemsSource="{Binding Characters}"
                             SelectedItem="{Binding SelectedCharacter, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold" />

                                    <TextBlock Text="{Binding Id}"
                                               Opacity="0.65"
                                               FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <ScrollViewer Grid.Column="1"
                              Margin="16,0,0,0">
                    <ItemsControl ItemsSource="{Binding SelectedCharacterEditors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PropertyEditorViewModel">
                                <Grid ColumnDefinitions="220,*"
                                      Margin="0,4">

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               VerticalAlignment="Center" />

                                    <TextBox Grid.Column="1"
                                             Text="{Binding TextValue, Mode=TwoWay}"
                                             IsVisible="{Binding UsesTextBox}" />

                                    <CheckBox Grid.Column="1"
                                              IsChecked="{Binding BooleanValue, Mode=TwoWay}"
                                              IsVisible="{Binding IsBoolean}" />

                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding EnumValues}"
                                              SelectedItem="{Binding Value, Mode=TwoWay}"
                                              IsVisible="{Binding IsEnum}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>