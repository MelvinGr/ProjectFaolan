<Project>
	<PropertyGroup>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<!--<RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>-->
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifier>
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</RuntimeIdentifier>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<Authors>Project Faolan</Authors>
		<Copyright>Copyright © Project Faolan $([System.DateTime]::Now.Year)</Copyright>
		<ApplicationIcon>..\logo.ico</ApplicationIcon>
		<!--<OutputPath>..\bin\$(Configuration)\</OutputPath>-->
		<Nullable>enable</Nullable>
		<!--<CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>-->
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Faolan.Tests" />
	</ItemGroup>

	<!--<PropertyGroup>
        <ProjectNameSlug>$([System.String]::Copy('$(MSBuildProjectName)').Replace('.', '_').ToLower())</ProjectNameSlug>

        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <DockerfilePath>../Dockerfile</DockerfilePath>
        <DockerfileContext>.</DockerfileContext>
        <DockerfileFastModeStage>$(ProjectNameSlug)</DockerfileFastModeStage>
        <<ContainerRepository>xx/$(ProjectNameSlug)</ContainerRepository>-
        <ContainerImageTag>dev</ContainerImageTag>
    </PropertyGroup>-->

	<!--
	  The startup banner's build stamp (Faolan.Core/Global.cs). `BuildDateTimeUtc` is a TIMESTAMP, so an assembly
	  carrying it can never be byte-identical across two builds of the same source - it was the whole of #551: three
	  no-op `dotnet build`s, three different `Faolan.Core.Database.dll` hashes, and that hash is part of the test
	  fixture cache key, so every build threw the cached fixture away.

	  It is scoped to the ENTRY assembly because that is the only place it is ever read: `Global` resolves both
	  attributes off `Assembly.GetEntryAssembly()` and degrades gracefully when they are absent, so the twelve library
	  copies were paying determinism for a value nothing could reach. `OutputType == Exe` is the condition rather than
	  a project list so a new host picks it up by being a host.

	  ⚠️ The executables themselves are still non-deterministic by construction - that is what a build timestamp IS.
	  Making them deterministic too means sourcing the stamp from the COMMIT rather than the clock; the git SHA
	  already rides along for free in the informational version, so the date is the only piece left.
	-->
	<Target Name="GenerateBuildInfo" BeforeTargets="BeforeCompile" Condition="'$(OutputType)' == 'Exe'">
		<ItemGroup>
			<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
				<_Parameter1>BuildDateTimeUtc</_Parameter1>
				<_Parameter2>$([System.DateTime]::UtcNow.ToString("O"))</_Parameter2>
			</AssemblyAttribute>

			<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
				<_Parameter1>BuildConfiguration</_Parameter1>
				<_Parameter2>$(Configuration)</_Parameter2>
			</AssemblyAttribute>
		</ItemGroup>
	</Target>

	<!--<Target Name="RemoveUnneededRuntimeFolders" AfterTargets="CopyFilesToOutputDirectory"
	        Condition="'$(Configuration)' == 'Debug'">
		<ItemGroup>
			<RuntimeFolders
				Include="$([System.IO.Directory]::GetDirectories('$(TargetDir)runtimes'))"
				Condition="Exists('$(TargetDir)runtimes')" />

			<RuntimeFoldersToRemove Include="@(RuntimeFolders)"
			                        Exclude="$(TargetDir)runtimes/linux-x64;$(TargetDir)runtimes/win-x64" />
		</ItemGroup>

		<Message Importance="High"
		         Text="Removing runtime folders: @(RuntimeFoldersToRemove)"
		         Condition="'@(RuntimeFoldersToRemove)' != ''" />

		<RemoveDir Directories="@(RuntimeFoldersToRemove)" />
	</Target>-->

	<Import Project="Directory.Build.user.props" Condition="Exists('Directory.Build.user.props')" />
</Project>
