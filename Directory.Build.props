<Project>
	<PropertyGroup>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<Nullable>enable</Nullable>
		<!--<CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>-->

		<!--<RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>-->
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>

		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

		<Authors>Project Faolan</Authors>
		<Copyright>Copyright © Project Faolan $([System.DateTime]::Now.Year)</Copyright>
		<ApplicationIcon>..\logo.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Faolan.Tests" />
	</ItemGroup>

	<!--<PropertyGroup>
        <ProjectNameSlug>$([System.String]::Copy('$(MSBuildProjectName)').Replace('.', '_').ToLower())</ProjectNameSlug>

        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <DockerfilePath>../Dockerfile</DockerfilePath>
        <DockerfileContext>.</DockerfileContext>
        <DockerfileFastModeStage>$(ProjectNameSlug)</DockerfileFastModeStage>
        <<ContainerRepository>xx/$(ProjectNameSlug)</ContainerRepository>-
        <ContainerImageTag>dev</ContainerImageTag>
    </PropertyGroup>-->

	<Target Name="GenerateBuildInfo" BeforeTargets="BeforeCompile" Condition="'$(OutputType)' == 'Exe'">
		<ItemGroup>
			<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
				<_Parameter1>BuildDateTimeUtc</_Parameter1>
				<_Parameter2>$([System.DateTime]::UtcNow.ToString("O"))</_Parameter2>
			</AssemblyAttribute>

			<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
				<_Parameter1>BuildConfiguration</_Parameter1>
				<_Parameter2>$(Configuration)</_Parameter2>
			</AssemblyAttribute>
		</ItemGroup>
	</Target>

	<Import Project="Directory.Build.user.props" Condition="Exists('Directory.Build.user.props')" />
</Project>
