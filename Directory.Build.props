<Project>
    <PropertyGroup>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
        <!--<OutputPath>..\bin\$(Configuration)\</OutputPath>-->
        <Authors>Project Faolan</Authors>
        <ApplicationIcon>..\logo.ico</ApplicationIcon>
        <!--<CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>-->
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.6" />
    </ItemGroup>

    <!--<PropertyGroup>
        <ProjectNameSlug>$([System.String]::Copy('$(MSBuildProjectName)').Replace('.',
    '_').ToLower())</ProjectNameSlug>

        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <DockerfilePath>../Dockerfile</DockerfilePath>
        <DockerfileContext>.</DockerfileContext>
        <DockerfileFastModeStage>$(ProjectNameSlug)</DockerfileFastModeStage>
        <<ContainerRepository>xx/$(ProjectNameSlug)</ContainerRepository>-
        <ContainerImageTag>dev</ContainerImageTag>
    </PropertyGroup>-->

    <!-- SourceRevisionId is the HEAD commit SHA, populated by the SDK's bundled git
         source-control tasks (InitializeSourceControlInformation). Replaces GitVersion.MsBuild. -->
    <Target Name="GenerateBuildInfo" BeforeTargets="BeforeCompile"
        DependsOnTargets="InitializeSourceControlInformation">
        <ItemGroup>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>BuildDateTimeUtc</_Parameter1>
                <_Parameter2>$([System.DateTime]::UtcNow.ToString("O"))</_Parameter2>
            </AssemblyAttribute>

            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>BuildConfiguration</_Parameter1>
                <_Parameter2>$(Configuration)</_Parameter2>
            </AssemblyAttribute>

            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>GitSha</_Parameter1>
                <_Parameter2>$(SourceRevisionId)</_Parameter2>
            </AssemblyAttribute>
        </ItemGroup>
    </Target>

    <Target Name="RemoveUnneededRuntimeFolders" AfterTargets="CopyFilesToOutputDirectory"
        Condition="'$(Configuration)' == 'Debug'">
        <ItemGroup>
            <RuntimeFolders
                Include="$([System.IO.Directory]::GetDirectories('$(TargetDir)runtimes'))"
                Condition="Exists('$(TargetDir)runtimes')" />

            <RuntimeFoldersToRemove Include="@(RuntimeFolders)"
                Exclude="$(TargetDir)runtimes/linux-x64;$(TargetDir)runtimes/win-x64" />
        </ItemGroup>

        <Message Importance="High"
            Text="Removing runtime folders: @(RuntimeFoldersToRemove)"
            Condition="'@(RuntimeFoldersToRemove)' != ''" />

        <RemoveDir Directories="@(RuntimeFoldersToRemove)" />
    </Target>

    <Import Project="Directory.Build.user.props" Condition="Exists('Directory.Build.user.props')" />
</Project>