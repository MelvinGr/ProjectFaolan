<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Dual-role assembly: a LIBRARY hosted in-process by the game server (FaolanMcpHostedService), and an
             EXECUTABLE whose entry point is the Claude Code channel bridge (ChannelBridge.Main - spawned by
             Claude Code over stdio via .mcp.json "faolan-chat"). Exe-to-exe project references are fine. -->
        <OutputType>Exe</OutputType>
        <StartupObject>Faolan.Mcp.ChannelBridge</StartupObject>
        <!-- Required when referencing Microsoft.AspNetCore.App from the non-Web SDK on .NET 10 (NETSDK1226). -->
        <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Faolan.Core\Faolan.Core.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <!-- In-process MCP server (Claude tooling) hosted on a localhost Kestrel port. -->
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
        <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.0"/>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8"/>
    </ItemGroup>
</Project>
