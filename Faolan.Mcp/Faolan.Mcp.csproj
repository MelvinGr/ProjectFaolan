<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Dual-role assembly: a LIBRARY hosted in-process by the game server (FaolanMcpHostedService), and an
             EXECUTABLE whose entry point is the Claude Code channel bridge (ChannelBridge.Main - spawned by
             Claude Code over stdio via .mcp.json "faolan-chat"). Exe-to-exe project references are fine. -->
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <StartupObject>Faolan.Mcp.ChannelBridge</StartupObject>
        <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Faolan.Core\Faolan.Core.csproj" />
        <ProjectReference Include="..\Faolan.Core.Network\Faolan.Core.Network.csproj" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.1" />
    </ItemGroup>
</Project>
